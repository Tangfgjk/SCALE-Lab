COMPOSE_PROJECT_NAME=scale-lab
SITE_DOMAIN=scalelab.ccnu.edu.cn
APP_IMAGE=scale-lab:1.0.0
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8089
EDGE_SUBNET=172.30.84.0/24
PROXY_IP=172.30.84.2
# Replace after the university confirms exact HTTPS gateway addresses.
# Do NOT trust all private addresses or 0.0.0.0/0.
UPSTREAM_PROXY_CIDRS="127.0.0.1/32 ::1/128"
POSTGRES_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# URL-encode special characters. db:5432 is inside Docker, not local host:5433.
DATABASE_URL=postgres://scale_lab:replace-with-a-unique-password-at-least-12-characters@db:5432/scale_lab
